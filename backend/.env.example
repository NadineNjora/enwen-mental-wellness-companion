# Add these settings to the END of your existing .env; keep DB_* and JWT_SECRET.
# Never commit real keys or phone numbers.
AI_PROVIDER="ollama"
# Local model is pinned to llama3.2:3b; no API key or paid fallback.
# Install Ollama and run: ollama pull llama3.2:3b
OPENROUTER_API_KEY=""
# OpenRouter is pinned to meta-llama/llama-3.3-70b-instruct:free; no paid fallback.
# Existing Groq credentials may be kept, but are not used with this provider.
GROQ_API_KEY=""
# Use a chat model available in YOUR Groq account.
GROQ_MODEL=""

# For a deliberate live connection test to your own phone:
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
SMS_TEST_RECIPIENT=""
SMS_MODE="disabled"
LIVE_SMS_ENABLED=false

# Alternative own-phone SMS connection test; it is not an automatic alert.
# Choose one provider explicitly. No fallback or automatic send is enabled.
SMS_PROVIDER="brevo"
BREVO_SMS_SENDER=""
BREVO_SMS_SENDER_APPROVED=false
# Brevo SMS uses BREVO_API_KEY below; email verification does not approve SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_SENDER_APPROVED=false

# Brevo own-mailbox connection test, separate from local Mailpit invitations.
EMAIL_PROVIDER="brevo"
EMAIL_MODE="disabled"
LIVE_EMAIL_ENABLED=false
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_TEST_RECIPIENT=""
EMAIL_SENDER_VERIFIED=false

# Real contact invitation enrollment requires a deployed HTTPS response page.
# Independent of own-mailbox tests; keep disabled until deployment is verified.
PUBLIC_APP_URL=""
LIVE_CONTACT_EMAIL_ENABLED=false
LIVE_CONTACT_ALERTS_ENABLED=false
# Optional explicit signup invitation. Enable only on the public HTTPS deployment.
SIGNUP_CONTACT_INVITATIONS_ENABLED=false
# For an explicitly authorised laptop presentation only (not public deployment):
CONTACT_DELIVERY_MODE=production
LOCAL_DEMO_USER_EMAIL=
LOCAL_DEMO_RECIPIENT=
LOCAL_DEMO_NOTIFICATIONS=false
