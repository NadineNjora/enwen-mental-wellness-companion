# COPY to deploy/.env.production on your chosen server. Never commit that file.
# Use a hostname you own and point its DNS to the server; not a made-up domain.
APP_DOMAIN=your-owned-hostname.invalid
DB_NAME=enwen_db
DB_USER=enwen_app
DB_PASSWORD=REPLACE_WITH_FRESH_RANDOM_PASSWORD_AT_LEAST_24_CHARS
JWT_SECRET=REPLACE_WITH_FRESH_RANDOM_SECRET_AT_LEAST_64_CHARS
EMAIL_PROVIDER=brevo
EMAIL_SENDER_VERIFIED=false
EMAIL_FROM_ADDRESS=
BREVO_API_KEY=
LIVE_CONTACT_EMAIL_ENABLED=false
LIVE_EMAIL_ENABLED=false
EMAIL_MODE=disabled
LIVE_SMS_ENABLED=false
SMS_MODE=disabled
